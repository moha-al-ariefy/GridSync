<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_grid_tariff_source_list" model="ir.ui.view">
        <field name="name">grid.tariff.source.list</field>
        <field name="model">grid.tariff.source</field>
        <field name="arch" type="xml">
            <list js_class="grid_tariff_list">
                <field name="name"/>
                <field name="source_type"/>
                <field name="currency_id"/>
                <field name="last_sync_at" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_grid_tariff_source_form" model="ir.ui.view">
        <field name="name">grid.tariff.source.form</field>
        <field name="model">grid.tariff.source</field>
        <field name="arch" type="xml">
            <form string="Tariff Source" js_class="grid_tariff_form" class="o_gridsync_tariff">
                <header>
                    <button name="action_sync_energy_charts" type="object" string="Sync prices" class="btn-primary" groups="mrp_grid_scheduler.group_grid_manager" invisible="source_type != 'energy_charts' or not id"/>
                    <button name="action_open_tariff_load" type="object" string="Generate intervals" class="btn-primary"
                            groups="mrp_grid_scheduler.group_grid_manager" invisible="source_type != 'manual_tou' or not id or not active"/>
                    <button name="action_open_tariff_load" type="object" string="Import CSV" class="btn-primary"
                            groups="mrp_grid_scheduler.group_grid_manager" invisible="source_type != 'csv' or not id or not active"/>
                </header>
                <sheet>
                    <div class="o_gridsync_record_header">
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="e.g. Factory tariff"/></h1>
                        </div>
                        <div class="o_gridsync_sync_summary" invisible="source_type != 'energy_charts' or not id">
                            <i class="fa fa-clock-o" aria-hidden="true"/>
                            <label for="last_sync_at" string="Last successful sync" class="fw-semibold" invisible="not last_sync_at"/>
                            <field name="last_sync_at" invisible="not last_sync_at" readonly="1"/>
                            <span invisible="last_sync_at">Awaiting first sync</span>
                        </div>
                    </div>
                    <field name="profile_dirty" invisible="1"/>
                    <p class="alert alert-warning" role="status" invisible="not profile_dirty or not last_sync_at">
                        Rules or dates changed. Generate intervals again before using those prices.
                    </p>
                    <group>
                        <group>
                            <field name="source_type" readonly="id"/>
                            <field name="energy_charts_market" invisible="source_type != 'energy_charts'"
                                   required="source_type == 'energy_charts'" readonly="id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="currency_id" force_save="1" readonly="source_type == 'energy_charts'"/>
                            <field name="timezone" force_save="1" readonly="source_type == 'energy_charts'"/>
                        </group>
                        <group invisible="source_type != 'manual_tou'">
                            <field name="valid_from" required="source_type == 'manual_tou'"/>
                            <field name="valid_to" required="source_type == 'manual_tou'"/>
                        </group>
                        <group invisible="source_type != 'csv'">
                            <field name="csv_price_basis"/>
                        </group>
                        <group invisible="source_type == 'energy_charts'">
                            <field name="source_reference" id="manual_source_reference"/>
                            <field name="attribution" id="manual_attribution"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Price intervals" name="prices">
                            <p class="text-muted o_gridsync_table_note">15-minute intervals. Prices are per MWh. Times follow your Odoo timezone.</p>
                            <field name="slot_ids" readonly="source_type != 'manual'">
                                <list editable="bottom">
                                    <field name="start_utc" string="Start"/>
                                    <field name="minutes" column_invisible="1"/>
                                    <field name="price_per_mwh"/>
                                    <field name="currency_id"/>
                                    <field name="is_current" optional="show"/>
                                    <field name="observed_at" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Time-of-use rules" name="tou_rules" invisible="source_type != 'manual_tou'">
                            <p class="text-muted o_gridsync_table_note">Use local time and prices per kWh. Leave both season dates empty for a year-round rule. Split overnight rules at midnight.</p>
                            <field name="rule_ids">
                                <list editable="bottom">
                                    <field name="weekday"/>
                                    <field name="start_time"/>
                                    <field name="end_time"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="price_per_kwh"/>
                                </list>
                            </field>
                        </page>
                        <page string="Load history" name="sync_history" invisible="source_type == 'manual'">
                            <field name="sync_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="started_at"/>
                                    <field name="state" widget="badge" decoration-success="state == 'success'" decoration-danger="state == 'failed'"/>
                                    <field name="inserted"/>
                                    <field name="updated"/>
                                    <field name="missing"/>
                                    <field name="message"/>
                                    <field name="http_status" optional="hide"/>
                                    <field name="duration_ms" optional="hide"/>
                                    <field name="payload_hash" optional="hide"/>
                                    <field name="next_allowed_at" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Data source" name="provider" invisible="source_type != 'energy_charts'">
                            <group>
                                <group>
                                    <field name="source_reference" id="provider_source_reference" readonly="1"/>
                                    <field name="attribution" id="provider_attribution" readonly="1"/>
                                </group>
                                <group>
                                    <field name="generated_at"/>
                                    <field name="license_text"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_grid_tariff_source" model="ir.actions.act_window">
        <field name="name">Tariff Sources</field>
        <field name="res_model">grid.tariff.source</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a tariff source</p>
            <p>Enter prices or recurring rules, import a CSV, or connect the Energy-Charts market feed.</p>
        </field>
    </record>
    <menuitem id="menu_grid_tariffs" name="Tariffs" parent="menu_grid_root" action="action_grid_tariff_source" groups="group_grid_planner" sequence="20"/>
</odoo>
