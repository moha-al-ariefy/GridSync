<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_grid_tariff_load_form" model="ir.ui.view">
        <field name="name">grid.tariff.load.form</field>
        <field name="model">grid.tariff.load</field>
        <field name="arch" type="xml">
            <form>
                <field name="source_type" invisible="1"/>
                <group>
                    <field name="source_id" options="{'no_open': True}"/>
                    <field name="first_day" invisible="source_type != 'manual_tou'" required="source_type == 'manual_tou'"/>
                    <field name="last_day" invisible="source_type != 'manual_tou'" required="source_type == 'manual_tou'"/>
                    <field name="csv_filename" invisible="1"/>
                    <field name="csv_file" filename="csv_filename" options="{'accepted_file_extensions': '.csv'}"
                           invisible="source_type != 'csv'" required="source_type == 'csv'"/>
                    <field name="replace_existing" invisible="source_type != 'csv'"/>
                </group>
                <p invisible="source_type != 'manual_tou'">Dates are inclusive and use the tariff timezone. Any hours without a rule stay empty.</p>
                <p invisible="source_type != 'csv'">Use UTF-8 with the header <code>start,price_per_mwh,currency</code>. Timestamps need a UTC offset or Z.</p>
                <footer>
                    <button name="action_load" type="object" string="Generate" class="btn-primary" invisible="source_type != 'manual_tou'"/>
                    <button name="action_load" type="object" string="Import" class="btn-primary" invisible="source_type != 'csv'"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_grid_tariff_load" model="ir.actions.act_window">
        <field name="name">Load price intervals</field>
        <field name="res_model">grid.tariff.load</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_grid_tariff_load_form"/>
        <field name="target">new</field>
        <field name="group_ids" eval="[(4, ref('group_grid_manager'))]"/>
    </record>
</odoo>
