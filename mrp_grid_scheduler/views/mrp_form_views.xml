<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_grid_manufacturing_order_form" model="ir.ui.view">
        <field name="name">mrp.production.form.grid.save</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="/form" position="attributes"><attribute name="js_class">grid_record_form</attribute></xpath>
        </field>
    </record>
    <record id="view_grid_bom_form" model="ir.ui.view">
        <field name="name">mrp.bom.form.grid.save</field>
        <field name="model">mrp.bom</field>
