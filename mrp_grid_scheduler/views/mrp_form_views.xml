        <field name="arch" type="xml">
            <xpath expr="/form" position="attributes"><attribute name="js_class">grid_record_form</attribute></xpath>
        </field>
    </record>
    <record id="view_grid_operation_form" model="ir.ui.view">
        <field name="name">mrp.routing.workcenter.form.grid.save</field>
        <field name="model">mrp.routing.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_routing_workcenter_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="/form" position="attributes"><attribute name="js_class">grid_record_form</attribute></xpath>
        </field>
    </record>
    <record id="view_grid_product_form" model="ir.ui.view">
        <field name="name">product.template.form.grid.save</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="/form" position="attributes"><attribute name="js_class">grid_record_form</attribute></xpath>
        </field>
    </record>
</odoo>
