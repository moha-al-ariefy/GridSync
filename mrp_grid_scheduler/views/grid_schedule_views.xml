<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_grid_schedule_run_list" model="ir.ui.view">
        <field name="name">grid.schedule.run.list</field>
        <field name="model">grid.schedule.run</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="workcenter_ids" widget="many2many_tags" optional="show"/>
                <field name="currency_id" optional="show"/>
                <field name="objective" optional="show"/>
                <field name="proposed_cost" optional="show" invisible="objective == 'gb_carbon'"/>
                <field name="proposed_carbon_kg" optional="show" invisible="objective == 'cost'"/>
                <field name="unscheduled_count" optional="show"/>
                <field name="state" widget="badge" decoration-info="state in ('draft', 'queued')" decoration-danger="state == 'failed'" decoration-success="state == 'applied'" decoration-muted="state == 'reverted'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_grid_schedule_run_form" model="ir.ui.view">
        <field name="name">grid.schedule.run.form</field>
        <field name="model">grid.schedule.run</field>
        <field name="arch" type="xml">
            <form string="Schedule proposal" js_class="grid_record_form">
                <header>
                    <button name="action_compute" type="object" string="Compute proposal" class="btn-primary" invisible="state != 'draft' or not id"/>
                    <button name="action_review_apply" type="object" string="Review and apply" class="btn-primary"
                            invisible="state != 'proposed' or not moved_count"/>
                    <button name="action_review_revert" type="object" string="Review revert"
                            invisible="state != 'applied'"/>
                    <button name="action_new_run" type="object" string="New run with these settings" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <field name="complete" invisible="1"/>
                    <field name="has_current_cost" invisible="1"/>
                    <field name="has_lower_bound" invisible="1"/>
                    <p class="alert alert-info" role="status" invisible="state != 'proposed' or not complete or not moved_count">
                        Review the dates and estimates before applying this proposal.
                    </p>
                    <p class="alert alert-info" role="status" invisible="state != 'proposed' or not has_current_cost or moved_count or objective != 'cost'">
                        No better schedule was found for the selected objective. The current bookings stay in place.
                    </p>
                    <p class="alert alert-warning" role="alert" invisible="state != 'proposed' or complete">
                        Some operations could not be scheduled. Any existing bookings for them stay in place.
                        Review and apply will move only the operations marked Moved.
                    </p>
                    <p class="alert alert-info" role="status" invisible="state != 'queued'">
                        This proposal is queued. Refresh this page after the scheduler has had time to run.
                    </p>
                    <div class="alert alert-warning" role="alert" invisible="state != 'failed'">
                        <field name="compute_error" nolabel="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="objective" readonly="state != 'draft'"/>
                            <field name="carbon_price" invisible="objective != 'gb_combined'" readonly="state != 'draft'"/>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="workcenter_ids" widget="many2many_tags" readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <p class="text-muted" invisible="state != 'draft'">
                        Choose work centers with schedule suggestions turned on. Operations that are ready or waiting, and either
                        unplanned or planned to start in this period, are included. Other bookings stay in place.
                    </p>
                    <group invisible="state in ('draft', 'queued', 'failed')">
                        <group string="Estimated energy cost" invisible="objective == 'gb_carbon'">
                            <field name="currency_id" options="{'no_open': True}"/>
                            <field name="proposed_cost"/>
                            <field name="shift_penalty" invisible="not shift_penalty"/>
                            <field name="current_cost" invisible="not has_current_cost"/>
                            <field name="saving" invisible="not has_current_cost"/>
                            <field name="lower_bound" invisible="not has_lower_bound"/>
                            <field name="gap" invisible="not has_lower_bound"/>
                        </group>
                        <group string="Estimated electricity emissions" invisible="objective == 'cost'">
                            <field name="proposed_carbon_kg"/>
                            <field name="current_carbon_kg" invisible="not has_current_cost"/>
                            <field name="carbon_lower_bound_kg" invisible="not has_lower_bound"/>
                        </group>
                        <group string="Operations">
                            <field name="job_count"/>
                            <field name="moved_count"/>
                            <field name="unchanged_count"/>
                            <field name="unscheduled_count" decoration-warning="unscheduled_count"/>
                            <field name="computed_at"/>
                            <field name="method_label" invisible="state == 'draft'"/>
                        </group>
                    </group>
                    <group string="Schedule history" invisible="state not in ('applied', 'reverted')">
                        <group>
                            <field name="applied_at"/>
                            <field name="applied_by"/>
                        </group>
                        <group invisible="state != 'reverted'">
                            <field name="reverted_at"/>
                            <field name="reverted_by"/>
                        </group>
                    </group>
                    <notebook invisible="state in ('draft', 'queued', 'failed')">
                        <page string="Operations" name="lines">
                            <field name="line_ids">
                                <list create="0" delete="0" edit="0"
                                      decoration-info="status == 'moved'" decoration-warning="status == 'unscheduled'">
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="has_current_cost" column_invisible="1"/>
                                    <field name="operation_state" column_invisible="1"/>
                                    <field name="energy_result_ids" column_invisible="1"/>
                                    <field name="production_id"/>
                                    <field name="operation"/>
                                    <button name="action_open_meter_import" type="object" string="Import readings"
                                            groups="mrp_grid_scheduler.group_grid_manager" column_invisible="parent.state != 'applied'"
                                            invisible="status != 'moved' or operation_state != 'done' or energy_result_ids"/>
                                    <button name="action_open_energy_result" type="object" string="Energy result"
                                            column_invisible="parent.state != 'applied'" invisible="not energy_result_ids"/>
                                    <field name="workcenter_id"/>
                                    <field name="duration_minutes" optional="hide"/>
                                    <field name="deadline" optional="hide"/>
                                    <field name="current_start"/>
                                    <field name="current_end" optional="show"/>
                                    <field name="proposed_start"/>
                                    <field name="proposed_end"/>
                                    <field name="energy_kwh" optional="show"/>
                                    <field name="current_cost" column_invisible="parent.objective == 'gb_carbon'" invisible="not has_current_cost"/>
                                    <field name="proposed_cost" column_invisible="parent.objective == 'gb_carbon'" invisible="status == 'unscheduled'"/>
                                    <field name="shift_penalty" column_invisible="parent.objective == 'gb_carbon'" optional="hide"/>
                                    <field name="current_carbon_kg" column_invisible="parent.objective == 'cost'" invisible="not has_current_cost"/>
                                    <field name="proposed_carbon_kg" column_invisible="parent.objective == 'cost'" invisible="status == 'unscheduled'"/>
                                    <field name="status" widget="badge" decoration-info="status == 'moved'"
                                           decoration-success="status == 'unchanged'" decoration-warning="status == 'unscheduled'"/>
                                    <field name="reason"/>
                                </list>
                            </field>
                        </page>
                        <page string="Data and assumptions" name="data">
                            <group><field name="method_label" invisible="state == 'draft'"/></group>
                            <field name="data_notes" class="o_gridsync_notes"/>
                            <ul class="text-muted mt-3">
                                <li invisible="objective == 'gb_carbon'">Costs are estimates: operating power × working time × the tariff price for each 15-minute interval. They are not metered energy or a supply bill.</li>
                                <li>Energy is counted only during working hours. A work center stays booked from an operation's start to its end, including breaks.</li>
                                <li>Times with missing data for the selected objective are skipped.</li>
                                <li>Small runs search combinations of start times and stop after a fixed search limit. Search result shows whether all available start-time combinations were checked. Operations start on 15-minute marks, at the start of working hours or at their current time.</li>
                                <li>The current schedule is used for cost comparison when its bookings are feasible and have prices. The lower bound is shown only when every operation is scheduled. It assumes each operation could take its cheapest time on its own, ignoring the others, within the same start times. No schedule using those start times can cost less.</li>
                                <li invisible="objective == 'cost'">GB emissions use NESO grid intensity and documented operating power. The combined objective adds the carbon charge at the entered price per tonne to the electricity cost. The two estimates are shown separately.</li>
                            </ul>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_grid_schedule_run_search" model="ir.ui.view">
        <field name="name">grid.schedule.run.search</field>
        <field name="model">grid.schedule.run</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="workcenter_ids"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="proposed" string="Proposed" domain="[('state', '=', 'proposed')]"/>
                <filter name="applied" string="Applied" domain="[('state', '=', 'applied')]"/>
                <filter name="reverted" string="Reverted" domain="[('state', '=', 'reverted')]"/>
            </search>
        </field>
    </record>
    <record id="view_grid_schedule_run_pivot" model="ir.ui.view">
        <field name="name">grid.schedule.run.pivot</field>
        <field name="model">grid.schedule.run</field>
        <field name="arch" type="xml">
            <pivot string="Proposal activity" disable_linking="1">
                <field name="state" type="row"/>
                <field name="computed_at" type="col" interval="month"/>
                <field name="proposed_cost" invisible="1"/>
                <field name="shift_penalty" invisible="1"/>
                <field name="current_cost" invisible="1"/>
                <field name="lower_bound" invisible="1"/>
                <field name="proposed_carbon_kg" invisible="1"/>
                <field name="current_carbon_kg" invisible="1"/>
                <field name="carbon_lower_bound_kg" invisible="1"/>
            </pivot>
        </field>
    </record>
    <record id="view_grid_schedule_run_graph" model="ir.ui.view">
        <field name="name">grid.schedule.run.graph</field>
        <field name="model">grid.schedule.run</field>
        <field name="arch" type="xml">
            <graph string="Proposal activity" type="bar" disable_linking="1">
                <field name="computed_at" interval="month"/>
                <field name="state"/>
                <field name="proposed_cost" invisible="1"/>
                <field name="shift_penalty" invisible="1"/>
                <field name="current_cost" invisible="1"/>
                <field name="lower_bound" invisible="1"/>
                <field name="proposed_carbon_kg" invisible="1"/>
                <field name="current_carbon_kg" invisible="1"/>
                <field name="carbon_lower_bound_kg" invisible="1"/>
            </graph>
        </field>
    </record>
    <record id="action_grid_schedule_run" model="ir.actions.act_window">
        <field name="name">Schedule proposals</field>
        <field name="res_model">grid.schedule.run</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a schedule proposal</p>
            <p>Choose a period and work centers. GridSync suggests lower-cost times without changing work orders.</p>
        </field>
    </record>
    <menuitem id="menu_grid_schedule" name="Schedule" parent="menu_grid_root" action="action_grid_schedule_run"
              groups="group_grid_planner" sequence="5"/>
    <record id="view_grid_schedule_confirm_form" model="ir.ui.view">
        <field name="name">grid.schedule.confirm.form</field>
        <field name="model">grid.schedule.confirm</field>
        <field name="arch" type="xml">
            <form>
                <field name="operation" invisible="1"/>
                <group><field name="run_id" options="{'no_open': True}"/></group>
                <p invisible="operation != 'apply'">Apply the reviewed dates to the operations marked Moved? GridSync checks the bookings again before saving.</p>
                <p invisible="operation != 'revert'">Restore the previous dates of the operations moved by this proposal? GridSync checks for new conflicts before saving.</p>
                <footer>
                    <button name="action_confirm" type="object" string="Apply schedule" class="btn-primary" invisible="operation != 'apply'"/>
                    <button name="action_confirm" type="object" string="Revert schedule" class="btn-primary" invisible="operation != 'revert'"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_grid_schedule_confirm" model="ir.actions.act_window">
        <field name="name">Confirm schedule change</field>
        <field name="res_model">grid.schedule.confirm</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_grid_schedule_confirm_form"/>
        <field name="target">new</field>
        <field name="group_ids" eval="[(4, ref('group_grid_planner'))]"/>
    </record>
</odoo>
