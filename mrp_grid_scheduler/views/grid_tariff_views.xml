<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_grid_tariff_source_list" model="ir.ui.view">
        <field name="name">grid.tariff.source.list</field>
        <field name="model">grid.tariff.source</field>
        <field name="arch" type="xml">
            <list js_class="grid_tariff_list">
                <field name="name"/>
                <field name="source_type"/>
                <field name="currency_id"/>
                <field name="last_sync_at" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_grid_tariff_source_form" model="ir.ui.view">
        <field name="name">grid.tariff.source.form</field>
        <field name="model">grid.tariff.source</field>
        <field name="arch" type="xml">
            <form string="Tariff Source" js_class="grid_tariff_form">
                <header>
                    <button name="action_sync_energy_charts" type="object" string="Sync prices" class="btn-primary" groups="mrp_grid_scheduler.group_grid_manager" invisible="source_type != 'energy_charts' or not id"/>
                </header>
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name" placeholder="e.g. Factory tariff"/></h1></div>
                    <group>
                        <group>
                            <field name="source_type" readonly="id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id"/>
                            <field name="timezone"/>
                        </group>
                        <group>
                            <field name="source_reference" readonly="source_type == 'energy_charts'"/>
                            <field name="attribution" readonly="source_type == 'energy_charts'"/>
                            <field name="last_sync_at" invisible="source_type != 'energy_charts'"/>
                            <field name="generated_at" invisible="source_type != 'energy_charts'"/>
                            <field name="license_text" invisible="source_type != 'energy_charts'"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <p class="text-muted">Prices are per MWh. Each interval lasts 15 minutes. Times are shown in your Odoo timezone.</p>
                    <notebook>
                        <page string="Price Intervals">
                            <field name="slot_ids" readonly="source_type == 'energy_charts'">
                                <list editable="bottom">
                                    <field name="start_utc" string="Start"/>
                                    <field name="minutes"/>
                                    <field name="price_per_mwh"/>
                                    <field name="currency_id"/>
                                    <field name="is_current" optional="show"/>
                                    <field name="observed_at" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Sync History" invisible="source_type != 'energy_charts'">
                            <field name="sync_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="started_at"/>
                                    <field name="state"/>
                                    <field name="inserted"/>
                                    <field name="updated"/>
                                    <field name="missing"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_grid_tariff_source" model="ir.actions.act_window">
        <field name="name">Tariff Sources</field>
        <field name="res_model">grid.tariff.source</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p>Add a tariff source to keep its prices and references together.</p></field>
    </record>
    <menuitem id="menu_grid_tariffs" name="Tariffs" parent="menu_grid_root" action="action_grid_tariff_source" groups="group_grid_planner" sequence="20"/>
</odoo>
