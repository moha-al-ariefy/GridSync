<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_grid_sync" model="res.groups.privilege">
        <field name="name">GridSync</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>
    <record id="group_grid_planner" model="res.groups">
        <field name="name">Planner</field>
        <field name="privilege_id" ref="privilege_grid_sync"/>
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>
    </record>
    <record id="group_grid_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_grid_sync"/>
        <field name="implied_ids" eval="[(4, ref('group_grid_planner'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
    <record id="rule_grid_site_company" model="ir.rule">
        <field name="name">GridSync sites by company</field>
        <field name="model_id" ref="model_grid_site"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_grid_tariff_source_company" model="ir.rule">
        <field name="name">GridSync tariff sources by company</field>
        <field name="model_id" ref="model_grid_tariff_source"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_grid_tariff_slot_company" model="ir.rule">
        <field name="name">GridSync price intervals by company</field>
        <field name="model_id" ref="model_grid_tariff_slot"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_grid_tariff_sync_company" model="ir.rule">
        <field name="name">GridSync sync logs by company</field>
        <field name="model_id" ref="model_grid_tariff_sync"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_grid_tariff_rule_company" model="ir.rule">
        <field name="name">GridSync time-of-use rules by company</field>
        <field name="model_id" ref="model_grid_tariff_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_grid_schedule_run_company" model="ir.rule">
        <field name="name">GridSync schedule proposals by company</field>
        <field name="model_id" ref="model_grid_schedule_run"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_grid_schedule_line_company" model="ir.rule">
        <field name="name">GridSync proposed operations by company</field>
        <field name="model_id" ref="model_grid_schedule_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
