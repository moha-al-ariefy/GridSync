<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_grid_site_list" model="ir.ui.view">
        <field name="name">grid.site.list</field>
        <field name="model">grid.site</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="workcenter_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>
    <record id="view_grid_site_form" model="ir.ui.view">
        <field name="name">grid.site.form</field>
        <field name="model">grid.site</field>
        <field name="arch" type="xml">
            <form string="Site">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Main factory"/></h1>
                    </div>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active" invisible="1"/>
                        <field name="workcenter_ids" widget="many2many_tags" domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]"/>
                    </group>
                    <p class="text-muted">Add the work centers at this site. Prices and scheduling will be added in the next stages.</p>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_grid_site" model="ir.actions.act_window">
        <field name="name">Sites</field>
        <field name="res_model">grid.site</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <div class="o_gridsync_welcome">
                <h2>Welcome to GridSync</h2>
                <p>Start by adding a site and its work centers.</p>
                <p>Tariffs and scheduling come next.</p>
            </div>
        </field>
    </record>
    <record id="action_grid_guide" model="ir.actions.client">
        <field name="name">Getting Started</field>
        <field name="tag">mrp_grid_scheduler.guide</field>
    </record>
    <menuitem id="menu_grid_root" name="GridSync" groups="group_grid_planner" web_icon="mrp_grid_scheduler,static/description/icon.png" sequence="140"/>
    <menuitem id="menu_grid_guide" name="Getting Started" parent="menu_grid_root" action="action_grid_guide" groups="group_grid_planner" sequence="1"/>
    <menuitem id="menu_grid_sites" name="Sites" parent="menu_grid_root" action="action_grid_site" groups="group_grid_planner" sequence="10"/>
</odoo>
