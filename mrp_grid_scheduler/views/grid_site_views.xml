<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_grid_site_list" model="ir.ui.view">
        <field name="name">grid.site.list</field>
        <field name="model">grid.site</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="workcenter_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>
    <record id="view_grid_site_form" model="ir.ui.view">
        <field name="name">grid.site.form</field>
        <field name="model">grid.site</field>
        <field name="arch" type="xml">
            <form string="Site" js_class="grid_record_form">
                <sheet>
                    <div class="oe_button_box" name="button_box" invisible="not id">
                        <button name="action_open_schedules" type="object" string="Schedule proposals"
                                class="oe_stat_button" icon="fa-calendar"/>
                        <button name="action_open_energy_results" type="object" string="Energy results"
                                class="oe_stat_button" icon="fa-bolt"/>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Main factory"/></h1>
                    </div>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active" invisible="1"/>
                        <field name="workcenter_ids" widget="many2many_tags" domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]"/>
                        <field name="tariff_ids" widget="many2many_tags" readonly="1"/>
                    </group>
                    <p class="text-muted">The tariffs come from the work centers assigned here.</p>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_grid_site" model="ir.actions.act_window">
        <field name="name">Sites</field>
        <field name="res_model">grid.site</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a site</p>
            <p>Assign its work centers after creating the site.</p>
        </field>
    </record>
    <record id="action_grid_about" model="ir.actions.client">
        <field name="name">About</field>
        <field name="tag">mrp_grid_scheduler.about</field>
    </record>
    <record id="action_grid_dashboard" model="ir.actions.client">
        <field name="name">Your Dashboard</field>
        <field name="tag">mrp_grid_scheduler.dashboard</field>
    </record>
    <menuitem id="menu_grid_root" name="GridSync" groups="group_grid_planner" web_icon="mrp_grid_scheduler,static/description/icon-purple.png" sequence="140"/>
    <menuitem id="menu_grid_about" name="About" parent="menu_grid_root" action="action_grid_about" groups="group_grid_planner" sequence="1"/>
    <menuitem id="menu_grid_dashboard" name="Your Dashboard" parent="menu_grid_root" action="action_grid_dashboard" groups="group_grid_planner" sequence="2"/>
    <menuitem id="menu_grid_sites" name="Sites" parent="menu_grid_root" action="action_grid_site" groups="group_grid_planner" sequence="10"/>
</odoo>
